{
  "name": "web_search",
  "description": "Search the web with Tavily and return ranked results: titles, URLs, and content excerpts. Use it for current information beyond the workspace.",
  "command": ["./web-search.py"],
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {"type": "string", "description": "Search query."},
      "max_results": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "description": "Number of results. Defaults to 5."
      },
      "topic": {
        "type": "string",
        "enum": ["general", "news"],
        "description": "Search category. Defaults to general."
      },
      "include_answer": {
        "type": "boolean",
        "description": "Include a short synthesized answer. Defaults to true."
      }
    },
    "required": ["query"]
  },
  "timeout_seconds": 45,
  "capabilities": ["network"]
}
